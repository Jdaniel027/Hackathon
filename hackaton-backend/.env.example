# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# 0 = sin proxy de confianza; configurar solo cuando el despliegue tenga un proxy conocido.
TRUST_PROXY_HOPS=0

# ─── Base de datos ─────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@localhost:5432/aquareport?schema=public

# ─── Integraciones externas ────────────────────────────
# Solo backend. Nunca en el front ni en git.
GEMINI_API_KEY=

# ─── Admin ─────────────────────────────────────────────
# >= 32 caracteres. Protege las rutas /admin/*.
ADMIN_API_KEY=cambiar-por-una-clave-de-al-menos-32-caracteres

# ─── Rate limiting ─────────────────────────────────────
# 0 en un límite = sin límite (útil en pruebas locales; NO en producción).
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_GLOBAL_TTL_MS=60000
RATE_LIMIT_REPORTES_LIMIT=2
RATE_LIMIT_REPORTES_TTL_MS=900000
RATE_LIMIT_ADMIN_LIMIT=40
RATE_LIMIT_ADMIN_TTL_MS=900000

# ─── Redis (futuro, ignorado en el MVP) ────────────────
# REDIS_URL=redis://localhost:6379
# MAPA_CACHE_TTL_SECONDS=900
